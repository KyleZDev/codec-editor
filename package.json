{
  "name": "codec",
  "version": "1.0.0",
  "description": "Codec - Code Editor",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "assets": "python build/make-assets.py",
    "notices": "node build/gen-notices.js",
    "dist": "node build/gen-notices.js && electron-builder --win nsis --x64",
    "dist:linux": "node build/gen-notices.js && electron-builder --linux AppImage --x64"
  },
  "keywords": [],
  "type": "commonjs",
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@vscode/codicons": "^0.0.46-24",
    "@xhayper/discord-rpc": "^1.5.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "adm-zip": "^0.6.1",
    "dompurify": "^3.4.17",
    "marked": "^14.0.0",
    "material-icon-theme": "^5.40.0",
    "monaco-editor": "^0.58.0"
  },
  "productName": "Codec",
  "author": "KyleZ",
  "license": "SEE LICENSE IN LICENSE.txt",
  "private": true,
  "build": {
    "appId": "com.kylez.codec",
    "productName": "Codec",
    "copyright": "Copyright © 2026 KyleZ. All rights reserved.",
    "electronVersion": "45.5.0",
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "discord.js",
      "extensions.js",
      "renderer/**/*",
      "package.json",
      "!node_modules/monaco-editor/{esm,dev}/**",
      "!node_modules/monaco-editor/monaco.d.ts",
      "!node_modules/**/*.map",
      "!node_modules/**/*.md",
      "!node_modules/**/test/**"
    ],
    "asarUnpack": [
      "node_modules/@lydell/**"
    ],
    "extraResources": [
      {
        "from": "LICENSE.txt",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      },
      {
        "from": "LICENSE.md",
        "to": "LICENSE.md"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "legalTrademarks": "Codec",
      "executableName": "Codec"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "license": "LICENSE.txt",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Codec",
      "uninstallDisplayName": "Codec",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "en_US"
      ],
      "displayLanguageSelector": false,
      "unicode": true,
      "include": "build/installer.nsh",
      "artifactName": "Codec-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "executableName": "codec"
    },
    "appImage": {
      "artifactName": "Codec-${version}-${arch}.${ext}"
    }
  }
}
